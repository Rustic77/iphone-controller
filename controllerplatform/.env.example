# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# HTTP / WebSocket listener
HOST=0.0.0.0
PORT=8080

# Secret used to sign browser session tokens (HMAC). Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SECRET=8f39c72d6b4e19a1e78d3529c90f8346a9b3e5d218e72136d87a19f51b8c624d

# --- Development browser (operator) credential ------------------------------
# The MVP ships with a single dev operator account. Replace with a real
# account system later (see src/stores/userStore.ts).
DEV_USERNAME=admin
DEV_PASSWORD=Test1234
# Stable id for the dev operator; devices are owned by this id in the seed file.
DEV_USER_ID=dev-operator

# --- Device credentials -----------------------------------------------------
# Path to the JSON file that lists registered ESP32 devices + their secrets.
# See devices.example.json. NEVER commit the real devices.json.
DEVICES_FILE=./devices.json

# --- Timing knobs (milliseconds) -------------------------------------------
# App-level heartbeat ping interval and how long to wait for a pong before
# considering the socket dead.
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_TIMEOUT_MS=30000
# Control messages whose timestamp is older than this are dropped as stale.
STALE_COMMAND_MS=2000

# Session token lifetime (milliseconds). Default 12h.
SESSION_TTL_MS=43200000

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
