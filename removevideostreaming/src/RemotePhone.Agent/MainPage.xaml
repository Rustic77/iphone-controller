<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="RemotePhone_Agent.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RemotePhone_Agent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:RemotePhone.Agent.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="16" ColumnSpacing="16" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Left: receivers -->
        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="AirPlay Receivers" />

            <ListView
                x:Name="ReceiverList"
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Receivers, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedReceiver, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ReceiverWindowInfo">
                        <StackPanel Spacing="2" Padding="4">
                            <TextBlock Text="{x:Bind Title}" TextWrapping="WrapWholeWords" FontWeight="SemiBold" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.75"
                                Text="{x:Bind ProcessName}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.RefreshReceiversCommand}" Content="Refresh" />
                <Button
                    Command="{x:Bind ViewModel.SelectAirPlayWindowCommand}"
                    Content="SELECT AIRPLAY WINDOW"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <TextBlock
                Grid.Row="3"
                Margin="0,8,0,0"
                IsTextSelectionEnabled="True"
                Text="{x:Bind ViewModel.SelectedDetails, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
        </Grid>

        <!-- Center: preview -->
        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Live Preview" />
            <Border
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Image
                    x:Name="PreviewImage"
                    Stretch="Uniform"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Border>
        </Grid>

        <!-- Right: status / webrtc / diagnostics -->
        <Grid Grid.Column="2" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Capture" />
                <TextBlock Text="{x:Bind ViewModel.CaptureStatus, Mode=OneWay}" />
                <TextBlock>
                    <Run Text="Resolution: " />
                    <Run Text="{x:Bind ViewModel.SourceResolution, Mode=OneWay}" />
                </TextBlock>
                <TextBlock>
                    <Run Text="Orientation: " />
                    <Run Text="{x:Bind ViewModel.Orientation, Mode=OneWay}" />
                </TextBlock>
                <TextBlock>
                    <Run Text="FPS: " />
                    <Run Text="{x:Bind ViewModel.CaptureFps, Mode=OneWay}" />
                </TextBlock>
                <TextBlock>
                    <Run Text="Dropped: " />
                    <Run Text="{x:Bind ViewModel.DroppedFrames, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="WebRTC" />
                <TextBlock>
                    <Run Text="State: " />
                    <Run Text="{x:Bind ViewModel.WebRtcState, Mode=OneWay}" />
                </TextBlock>
                <TextBlock>
                    <Run Text="Stream FPS: " />
                    <Run Text="{x:Bind ViewModel.StreamFps, Mode=OneWay}" />
                </TextBlock>
                <TextBlock>
                    <Run Text="Bitrate (kbps): " />
                    <Run Text="{x:Bind ViewModel.Bitrate, Mode=OneWay}" />
                </TextBlock>
                <TextBlock>
                    <Run Text="RTT (ms): " />
                    <Run Text="{x:Bind ViewModel.Rtt, Mode=OneWay}" />
                </TextBlock>
                <TextBlock>
                    <Run Text="Dropped: " />
                    <Run Text="{x:Bind ViewModel.WebRtcDropped, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.StartStreamCommand}"
                        Content="START"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button Command="{x:Bind ViewModel.StopStreamCommand}" Content="STOP" />
                    <Button Command="{x:Bind ViewModel.ReconnectCommand}" Content="RECONNECT" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="6">
                <Button Command="{x:Bind ViewModel.CalibratePointerCommand}" Content="CALIBRATE POINTER" />
                <Button Command="{x:Bind ViewModel.ToggleSoakTestCommand}" Content="TOGGLE SOAK TEST" />
                <TextBlock>
                    <Run Text="Calibration: " />
                    <Run Text="{x:Bind ViewModel.CalibrationStatus, Mode=OneWay}" />
                </TextBlock>
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.LastError, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Grid Grid.Row="3" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Diagnostics" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="12"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.Diagnostics, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Opacity="0.7"
            Text="Preview uses SoftwareBitmap (GPU→CPU) at ≤30 FPS. Streaming path (phase 2) will prefer GPU textures." />
    </Grid>
</Page>
