# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_TINYUSB_HID_COUNT=1
# Enable WebSocket support in esp_http_server (real-time control channel)
CONFIG_HTTPD_WS_SUPPORT=y

# --- Cloud client (outbound WSS) --------------------------------------------
# 2 MB flash on this build.
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="2MB"
# The outbound TLS cloud client pulls in mbedTLS + the CA certificate bundle,
# which pushes the image past the 1 MB single-app partition. Use the large
# single-app layout (~1.5 MB app), which still fits 2 MB flash.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# TLS server-certificate verification uses the bundled Mozilla root CAs.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
